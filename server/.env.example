# ── Base de datos (Neon) ─────────────────────────────────────
# Crear proyecto en https://neon.tech y pegar aca la cadena de conexion.
# Ojo: agregar ?sslmode=require al final.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/gestione?sslmode=require"

# ── Autenticacion ────────────────────────────────────────────
# Generar cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="cambiar-por-cadena-aleatoria-larga"
JWT_REFRESH_SECRET="cambiar-por-otra-cadena-aleatoria-distinta"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DIAS="7"

# ── Servidor ─────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ── Cloudinary (estampados del personalizador) ───────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
