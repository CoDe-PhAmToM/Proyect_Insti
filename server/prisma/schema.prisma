// ============================================================
// ESQUEMA DE BASE DE DATOS
// Plataforma de Gestion Financiera para la Rentabilidad
// Microempresas de Confeccion Informal - Distrito 6, El Alto
//
// Multi-taller: casi toda tabla de negocio cuelga de tallerId y
// el middleware de tenancy fuerza ese filtro en cada consulta.
// Un productor nunca puede leer datos de otro taller.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum Rol {
  ADMIN // equipo investigador: metricas agregadas y exportacion del piloto
  PRODUCTOR // duenio del taller
  AYUDANTE // registra movimientos, no ve margenes ni costos
  CLIENTE // compra en la tienda
}

// El documento mide "ingresos - egresos - retiros": el retiro del
// duenio es un tercer tipo, no un egreso mas.
enum TipoMovimiento {
  INGRESO
  EGRESO
  RETIRO
}

enum OrigenFondo {
  NEGOCIO
  PERSONAL
}

enum EstadoOrden {
  BORRADOR
  EN_PROCESO
  TERMINADA
  ENTREGADA
  CANCELADA
}

enum TipoMovMaterial {
  ENTRADA
  SALIDA
  AJUSTE
}

enum TipoCostoOrden {
  MATERIAL
  MANO_OBRA
  CIF
}

// El pago se coordina con QR Simple del BCB, que es el estandar
// interoperable boliviano: todas las apps bancarias lo leen. No hay
// pasarela — exigiria NIT y cuenta empresarial, y la poblacion del
// estudio es informal por definicion.
enum EstadoPago {
  PENDIENTE
  COMPROBANTE_SUBIDO
  CONFIRMADO
  RECHAZADO
}

enum EstadoPedido {
  NUEVO
  CONFIRMADO
  EN_PRODUCCION
  LISTO
  ENTREGADO
  CANCELADO
}

enum Severidad {
  INFO
  ADVERTENCIA
  CRITICA
}

enum TipoRecomendacion {
  OPORTUNIDAD
  PRECIO
  ALERTA
  PRONOSTICO
}

// ── Identidad y acceso ───────────────────────────────────────

model Usuario {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  nombre       String
  telefono     String?
  rol          Rol       @default(PRODUCTOR)
  activo       Boolean   @default(true)
  ultimoAcceso DateTime?
  creadoEn     DateTime  @default(now())
  actualizadoEn DateTime @updatedAt

  talleresPropios Taller[]        @relation("PropietarioTaller")
  membresias      UsuarioTaller[]
  refreshTokens   RefreshToken[]
  codigosReseteo  CodigoReseteo[]
  respuestasSus   RespuestaSus[]
  registros       Registro[]      @relation("RegistroCreadoPor")
  registrosAnulados Registro[]    @relation("RegistroAnuladoPor")
  erroresReportados ErrorApp[]
  pedidos         Pedido[]        @relation("PedidosDelCliente")
  eventos         EventoUso[]

  @@index([rol])
  @@map("usuarios")
}

model Taller {
  id            String   @id @default(uuid())
  nombre        String
  propietarioId String
  distrito      String   @default("Distrito 6 - El Alto")
  direccion     String?
  telefono      String?
  moneda        String   @default("BOB")
  // QR Simple del banco del taller. Lo sube una vez y el sistema se
  // lo muestra al cliente con el monto al cerrar el pedido.
  qrUrl         String?
  qrTitular     String?
  qrBanco       String?
  activo        Boolean  @default(true)
  // Marca si el taller participa del piloto de validacion (objetivo 5)
  enPiloto      Boolean  @default(false)
  creadoEn      DateTime @default(now())

  propietario Usuario @relation("PropietarioTaller", fields: [propietarioId], references: [id])

  miembros      UsuarioTaller[]
  materiales    Material[]
  productos     Producto[]
  costosFijos   CostoFijo[]
  registros     Registro[]
  ordenes       OrdenProduccion[]
  categorias    Categoria[]
  pedidos       Pedido[]
  alertas       Alerta[]
  recomendaciones Recomendacion[]
  lineasBase    LineaBase[]
  eventos       EventoUso[]
  respuestasSus RespuestaSus[]

  @@index([propietarioId])
  @@map("talleres")
}

model UsuarioTaller {
  id         String   @id @default(uuid())
  usuarioId  String
  tallerId   String
  rolEnTaller Rol     @default(AYUDANTE)
  creadoEn   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  taller  Taller  @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tallerId])
  @@index([tallerId])
  @@map("usuarios_talleres")
}

// El admin emite un codigo de un solo uso y se lo dicta a la
// persona por telefono. Sin correo: muchos microempresarios no
// tienen uno activo, y sin esto una clave olvidada saca a un taller
// del piloto entero.
model CodigoReseteo {
  id        String    @id @default(uuid())
  usuarioId String
  codigoHash String   @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  emitidoPor String
  creadoEn  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigos_reseteo")
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String
  tokenHash String   @unique
  expiraEn  DateTime
  revocado  Boolean  @default(false)
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ── Inventario ───────────────────────────────────────────────

model Material {
  id            String   @id @default(uuid())
  tallerId      String
  codigo        String
  nombre        String
  categoria     String // Tela, Hilo, Insumo
  unidad        String // metro, cono, rollo, unidad, kg
  precioUnitario Decimal @db.Decimal(12, 4)
  stock         Decimal  @default(0) @db.Decimal(12, 4)
  stockMinimo   Decimal  @default(0) @db.Decimal(12, 4)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  taller       Taller             @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  movimientos  MovimientoMaterial[]
  recetas      ProductoMaterial[]

  @@unique([tallerId, codigo])
  @@index([tallerId])
  @@map("materiales")
}

// El Kardex real. Hoy el reporte de Kardex del prototipo es una
// tabla inventada; con esta tabla pasa a calcularse de movimientos.
model MovimientoMaterial {
  id            String          @id @default(uuid())
  materialId    String
  tipo          TipoMovMaterial
  cantidad      Decimal         @db.Decimal(12, 4)
  costoUnitario Decimal         @db.Decimal(12, 4)
  // Saldos congelados al momento del movimiento: permiten reconstruir
  // el kardex sin recalcular toda la historia.
  saldoCantidad Decimal         @db.Decimal(12, 4)
  saldoValor    Decimal         @db.Decimal(12, 2)
  ordenId       String?
  motivo        String?
  fecha         DateTime        @db.Date
  creadoEn      DateTime        @default(now())

  material Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orden    OrdenProduccion? @relation(fields: [ordenId], references: [id])

  @@index([materialId, fecha])
  @@index([ordenId])
  @@map("movimientos_material")
}

// ── Productos y recetas ──────────────────────────────────────

model Producto {
  id                String   @id @default(uuid())
  tallerId          String
  sku               String
  nombre            String
  descripcion       String?
  precioVenta       Decimal  @db.Decimal(12, 2)
  // Mano de obra directa estimada por unidad, en Bs
  manoObraUnitaria  Decimal  @default(0) @db.Decimal(12, 2)
  // Prendas YA HECHAS y listas para vender. Distinto del inventario
  // de materiales: una cosa es tener tela, otra tener poleras.
  // Sin esto la tienda vendia infinito y la recomendacion de
  // "producto sin rotacion" hablaba de un stock que no existia.
  stock             Int      @default(0)
  stockMinimo       Int      @default(0)
  imagenUrl         String?
  emoji             String?
  categoria         String?
  activo            Boolean  @default(true)
  publicadoEnTienda Boolean  @default(false)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  taller  Taller             @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  receta  ProductoMaterial[]
  detalles OrdenDetalle[]
  items   PedidoItem[]
  registros Registro[]
  movimientos MovimientoProducto[]

  @@unique([tallerId, sku])
  @@index([tallerId])
  @@map("productos")
}

model ProductoMaterial {
  id         String  @id @default(uuid())
  productoId String
  materialId String
  cantidad   Decimal @db.Decimal(12, 4)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([productoId, materialId])
  @@map("producto_materiales")
}

// Kardex de prendas terminadas: entra lo que se produce, sale lo
// que se vende. Permite responder "cuantas poleras tengo hoy" y
// sostener la recomendacion de rotacion con datos reales.
model MovimientoProducto {
  id            String          @id @default(uuid())
  productoId    String
  tipo          TipoMovMaterial
  cantidad      Int
  saldo         Int
  ordenId       String?
  registroId    String?
  motivo        String?
  fecha         DateTime        @db.Date
  creadoEn      DateTime        @default(now())

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, fecha])
  @@map("movimientos_producto")
}

// ── Costos fijos: sin esta tabla no existe punto de equilibrio ──

model CostoFijo {
  id           String    @id @default(uuid())
  tallerId     String
  concepto     String // alquiler, luz, agua, internet
  montoMensual Decimal   @db.Decimal(12, 2)
  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date
  creadoEn     DateTime  @default(now())

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@index([tallerId, vigenteDesde])
  @@map("costos_fijos")
}

// ── Ordenes de produccion: el nucleo del objetivo 3 ──────────

model OrdenProduccion {
  id                String      @id @default(uuid())
  tallerId          String
  numero            Int
  clienteNombre     String?
  pedidoId          String?     @unique
  fechaPedido       DateTime    @db.Date
  fechaEntrega      DateTime?   @db.Date
  estado            EstadoOrden @default(BORRADOR)
  cantidadProducida Int         @default(0)
  notas             String?
  creadoEn          DateTime    @default(now())
  actualizadoEn     DateTime    @updatedAt

  taller      Taller               @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  pedido      Pedido?              @relation(fields: [pedidoId], references: [id])
  detalles    OrdenDetalle[]
  costos      OrdenCosto[]
  movimientos MovimientoMaterial[]
  registros   Registro[]

  @@unique([tallerId, numero])
  @@index([tallerId, estado])
  @@map("ordenes_produccion")
}

model OrdenDetalle {
  id                  String  @id @default(uuid())
  ordenId             String
  productoId          String
  cantidad            Int
  precioUnitarioVenta Decimal @db.Decimal(12, 2)

  orden    OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto Producto        @relation(fields: [productoId], references: [id])

  @@index([ordenId])
  @@map("orden_detalles")
}

// Acumulacion REAL de costos por orden (materiales + mano de obra +
// CIF prorrateado). Esto es costeo por ordenes; el prototipo actual
// solo hacia costeo estandar por producto.
model OrdenCosto {
  id          String         @id @default(uuid())
  ordenId     String
  tipo        TipoCostoOrden
  descripcion String
  cantidad    Decimal?       @db.Decimal(12, 4)
  monto       Decimal        @db.Decimal(12, 2)
  fecha       DateTime       @db.Date
  creadoEn    DateTime       @default(now())

  orden OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId, tipo])
  @@map("orden_costos")
}

// ── Movimientos financieros ──────────────────────────────────

model Categoria {
  id         String         @id @default(uuid())
  tallerId   String? // nulo = categoria global precargada
  nombre     String
  tipo       TipoMovimiento
  esPersonal Boolean        @default(false)
  orden      Int            @default(0)

  taller    Taller?    @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  registros Registro[]

  @@index([tallerId])
  @@map("categorias")
}

// Los campos calcan el cuaderno del microempresario: fecha, prenda,
// cantidad, precio. El indicador de la operativizacion mide justamente
// el % de campos que coinciden con lo que ya anota a mano.
model Registro {
  id             String         @id @default(uuid())
  tallerId       String
  fecha          DateTime       @db.Date
  tipo           TipoMovimiento
  categoriaId    String
  descripcion    String
  // "prenda / cantidad / precio" del cuaderno
  productoId     String?
  cantidad       Decimal?       @db.Decimal(12, 2)
  precioUnitario Decimal?       @db.Decimal(12, 2)
  monto          Decimal        @db.Decimal(12, 2)
  origen         OrigenFondo    @default(NEGOCIO)
  metodoPago     String?
  ordenId        String?
  creadoPorId    String
  // Marca los registros cargados como linea base desde el cuaderno,
  // para poder excluirlos del uso "real" de la plataforma.
  esLineaBase    Boolean        @default(false)
  // Un movimiento mal cargado se ANULA, no se edita ni se borra.
  // En contabilidad el rastro no se borra: queda la fila original
  // marcada y con el motivo, para que se pueda auditar que paso.
  anuladoEn      DateTime?
  anuladoPorId   String?
  motivoAnulacion String?
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  taller    Taller           @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  categoria Categoria        @relation(fields: [categoriaId], references: [id])
  producto  Producto?        @relation(fields: [productoId], references: [id])
  orden     OrdenProduccion? @relation(fields: [ordenId], references: [id])
  creadoPor Usuario          @relation("RegistroCreadoPor", fields: [creadoPorId], references: [id])
  anuladoPor Usuario?        @relation("RegistroAnuladoPor", fields: [anuladoPorId], references: [id])

  @@index([tallerId, fecha])
  @@index([tallerId, tipo])
  @@index([ordenId])
  @@map("registros")
}

// ── Tienda ───────────────────────────────────────────────────

model Pedido {
  id               String       @id @default(uuid())
  tallerId         String
  clienteId        String
  numero           Int
  estado           EstadoPedido @default(NUEVO)
  total            Decimal      @db.Decimal(12, 2)
  direccionEntrega String?
  telefonoContacto String?
  notas            String?
  estadoPago       EstadoPago @default(PENDIENTE)
  // Captura del comprobante de transferencia que sube el cliente
  comprobanteUrl   String?
  pagadoEn         DateTime?
  notaPago         String?
  creadoEn         DateTime     @default(now())
  actualizadoEn    DateTime     @updatedAt

  taller  Taller           @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  cliente Usuario          @relation("PedidosDelCliente", fields: [clienteId], references: [id])
  items   PedidoItem[]
  orden   OrdenProduccion?

  @@unique([tallerId, numero])
  @@index([clienteId])
  @@map("pedidos")
}

model PedidoItem {
  id             String  @id @default(uuid())
  pedidoId       String
  productoId     String
  cantidad       Int
  color          String?
  colorHex       String?
  talla          String?
  // URL en Cloudinary, no base64: el estampado no se guarda en la BD
  estampadoUrl   String?
  posicionJson   Json?
  precioUnitario Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@map("pedido_items")
}

// ── Instrumentacion para la tesis ────────────────────────────

// Alimenta los indicadores de la tabla de operativizacion:
// tiempo de registro semana 1 vs 3, frecuencia de uso, completitud.
model EventoUso {
  id         String   @id @default(uuid())
  usuarioId  String
  tallerId   String?
  tipoEvento String // registro_creado, orden_creada, reporte_visto...
  entidad    String?
  duracionMs Int?
  metadata   Json?
  creadoEn   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  taller  Taller? @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@index([tallerId, creadoEn])
  @@index([tipoEvento])
  @@map("eventos_uso")
}

model Alerta {
  id         String    @id @default(uuid())
  tallerId   String
  tipo       String // stock_critico, egreso_mayor_ingreso, precio_bajo_costo
  severidad  Severidad @default(ADVERTENCIA)
  mensaje    String
  entidadRef String?
  leida      Boolean   @default(false)
  resueltaEn DateTime?
  creadoEn   DateTime  @default(now())

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@index([tallerId, leida])
  @@index([tipo])
  @@map("alertas")
}

// El pretest. Se carga desde los cuadernos ANTES de empezar el
// piloto: sin esto no hay comparativo antes/despues (objetivo 5).
model LineaBase {
  id                    String   @id @default(uuid())
  tallerId              String
  periodo               String // "2026-03"
  ingresosDeclarados    Decimal  @db.Decimal(12, 2)
  egresosDeclarados     Decimal  @db.Decimal(12, 2)
  retirosDeclarados     Decimal  @default(0) @db.Decimal(12, 2)
  costoUnitarioEstimado Decimal? @db.Decimal(12, 2)
  margenConocidoPct     Decimal? @db.Decimal(5, 2)
  cifIdentificados      Int      @default(0)
  fuente                String   @default("cuaderno")
  notas                 String?
  creadoEn              DateTime @default(now())

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([tallerId, periodo])
  @@map("lineas_base")
}

// Escala SUS (System Usability Scale), 10 items estandar. El
// documento la promete como instrumento de la Fase II y hasta ahora
// no existia en ningun lado.
model RespuestaSus {
  id         String   @id @default(uuid())
  usuarioId  String
  tallerId   String?
  // Las 10 respuestas, de 1 a 5, en orden
  respuestas Int[]
  puntaje    Decimal  @db.Decimal(5, 2)
  comentario String?
  creadoEn   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  taller  Taller? @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@unique([usuarioId])
  @@map("respuestas_sus")
}

// Si algo falla en el celular de una microempresaria del Distrito
// 6, sin esto el equipo no se entera NUNCA. Ella cree que hizo algo
// mal, deja de usar el sistema, y el piloto pierde un caso sin que
// nadie sepa por que.
model ErrorApp {
  id         String   @id @default(uuid())
  origen     String // cliente | servidor
  mensaje    String
  pila       String?
  ruta       String?
  usuarioId  String?
  tallerId   String?
  navegador  String?
  metadata   Json?
  resuelto   Boolean  @default(false)
  creadoEn   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([creadoEn])
  @@index([resuelto])
  @@map("errores_app")
}

model Recomendacion {
  id         String            @id @default(uuid())
  tallerId   String
  tipo       TipoRecomendacion
  severidad  Severidad         @default(INFO)
  titulo     String
  mensaje    String
  accion     String?
  // Las cifras que originaron la recomendacion. La interfaz las
  // muestra: nada de "247 movimientos analizados" sin respaldo.
  datosJson  Json
  descartada Boolean           @default(false)
  generadaEn DateTime          @default(now())

  taller Taller @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@index([tallerId, descartada])
  @@map("recomendaciones")
}
